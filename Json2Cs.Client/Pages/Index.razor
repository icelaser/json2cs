@page "/"
@using System.Text.Json
@inject IJSRuntime JS
@inject CSharpClassGenerator Generator
@implements IDisposable

<PageTitle>json2cs.dev</PageTitle>

<div class="layout-container @MobileTabClass">
    @if (!string.IsNullOrWhiteSpace(InitializationError))
    {
        <div class="initialization-error">
            ⚠ @InitializationError
        </div>
    }
    <aside class="settings-panel @(SettingsCollapsed ? "collapsed" : "")">
        <button class="settings-toggle" @onclick="ToggleSettings" title="@(SettingsCollapsed ? "Settings aufklappen" : "Settings einklappen")">
            <span class="settings-toggle-icon">@(SettingsCollapsed ? "⚙" : "☰")</span>
            <span class="settings-toggle-text">Settings</span>
        </button>
        <div class="settings-content">
            <div class="settings-header">Settings</div>
            <div class="options">
                <strong>Mode</strong>
                <div class="option-group">
                    <label><input type="radio" name="mode" value="smart" checked="@(SmartMode)" @onchange="@(e => { SmartMode = true; Generate(); _ = SaveSettingsToCookie(); })" /> Smart</label>
                    <label><input type="radio" name="mode" value="strict" checked="@(!SmartMode)" @onchange="@(e => { SmartMode = false; Generate(); _ = SaveSettingsToCookie(); })" /> Strict</label>
                </div>

                <strong>Declaration</strong>
                <div class="option-group">
                    <label><input type="radio" name="declaration" value="class" checked="@(DeclarationType == "class")" @onchange="@(e => { DeclarationType = e.Value?.ToString() ?? "class"; Generate(); _ = SaveSettingsToCookie(); })" /> class</label>
                    <label><input type="radio" name="declaration" value="record" checked="@(DeclarationType == "record")" @onchange="@(e => { DeclarationType = e.Value?.ToString() ?? "record"; Generate(); _ = SaveSettingsToCookie(); })" /> record</label>
                </div>

                <strong>Attributes</strong>
                <div class="option-group">
                    <label><input type="radio" name="attributes" value="system" checked="@(AttributeMode == "system")" @onchange="@(e => { AttributeMode = e.Value?.ToString() ?? "system"; Generate(); _ = SaveSettingsToCookie(); })" /> System.Text.Json</label>
                    <label><input type="radio" name="attributes" value="newtonsoft" checked="@(AttributeMode == "newtonsoft")" @onchange="@(e => { AttributeMode = e.Value?.ToString() ?? "newtonsoft"; Generate(); _ = SaveSettingsToCookie(); })" /> Newtonsoft.Json</label>
                </div>

                <div class="option-group">
                    <strong>Namespace</strong>
                    <input type="text" placeholder="MyApp.Models" value="@Namespace" @onchange="@(e => { Namespace = e.Value?.ToString() ?? string.Empty; Generate(); _ = SaveSettingsToCookie(); })" />
                </div>

                <div class="option-group">
                    <strong>Root class name</strong>
                    <input type="text" placeholder="Root" value="@RootClassName" @onchange="@(e => { RootClassName = string.IsNullOrWhiteSpace(e.Value?.ToString()) ? "Root" : e.Value?.ToString() ?? "Root"; Generate(); _ = SaveSettingsToCookie(); })" />
                </div>

                <strong>Property style</strong>
                <div class="option-group">
                    <label><input type="radio" name="property-style" value="get; set;" checked="@(PropertyStyle == "get; set;")" @onchange="@(e => { PropertyStyle = e.Value?.ToString() ?? "get; set;"; Generate(); _ = SaveSettingsToCookie(); })" /> get; set;</label>
                    <label><input type="radio" name="property-style" value="get; init;" checked="@(PropertyStyle == "get; init;")" @onchange="@(e => { PropertyStyle = e.Value?.ToString() ?? "get; init;"; Generate(); _ = SaveSettingsToCookie(); })" /> get; init;</label>
                    <label><input type="radio" name="property-style" value="get;" checked="@(PropertyStyle == "get;")" @onchange="@(e => { PropertyStyle = e.Value?.ToString() ?? "get;"; Generate(); _ = SaveSettingsToCookie(); })" /> get;</label>
                </div>

                <div class="option-group">
                    <strong>Class suffix</strong>
                    <input type="text" placeholder="z.B. Dto, Model" value="@ClassSuffix" @onchange="@(e => { ClassSuffix = e.Value?.ToString() ?? string.Empty; Generate(); _ = SaveSettingsToCookie(); })" />
                </div>

                <div class="option-group">
                    <label><input type="checkbox" checked="@UseNullableReferences" @onchange="@(e => { UseNullableReferences = (bool)(e.Value ?? false); Generate(); _ = SaveSettingsToCookie(); })" /> Nullable</label>
                </div>
                <div class="option-group">
                    <label><input type="checkbox" checked="@UseList" @onchange="@(e => { UseList = (bool)(e.Value ?? false); Generate(); _ = SaveSettingsToCookie(); })" /> List&lt;T&gt;</label>
                </div>
            </div>
            @if (!string.IsNullOrWhiteSpace(ErrorMessage))
            {
                <div class="error-indicator">Ungültiges JSON</div>
            }
        </div>
    </aside>

    <div class="mobile-tabs">
        <button class="mobile-tab @(_mobileTab == "json" ? "active" : "")" @onclick='() => _mobileTab = "json"'>JSON Input</button>
        <button class="mobile-tab @(_mobileTab == "csharp" ? "active" : "")" @onclick='() => _mobileTab = "csharp"'>C# Output</button>
    </div>

    <section class="panel json-panel @(_fullscreenPanel == "json" ? "fullscreen" : "")">
        <div class="panel-header">
            <span class="panel-title">JSON Input</span>
            <div class="panel-actions">
                <button class="icon-btn" @onclick='() => ToggleFullscreen("json")' title="@(_fullscreenPanel == "json" ? "Vollbild verlassen" : "Vollbild")">
                    <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                        <path d="@(_fullscreenPanel == "json" ? CollapseIcon : ExpandIcon)" />
                    </svg>
                </button>
            </div>
        </div>
        <div class="editor-container json-input @(string.IsNullOrWhiteSpace(ErrorMessage) ? "" : "json-error")" id="json-editor"></div>
    </section>

    <section class="panel output-panel @(_fullscreenPanel == "csharp" ? "fullscreen" : "")">
        <div class="panel-header">
            <span class="panel-title">C# Output</span>
            <div class="panel-actions">
                <button class="icon-btn" @onclick='() => ToggleFullscreen("csharp")' title="@(_fullscreenPanel == "csharp" ? "Vollbild verlassen" : "Vollbild")">
                    <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                        <path d="@(_fullscreenPanel == "csharp" ? CollapseIcon : ExpandIcon)" />
                    </svg>
                </button>
                <button class="copy-btn @( _isCopied ? "copied" : "" )" @onclick="CopyCode" disabled="@string.IsNullOrWhiteSpace(GeneratedCode)" title="Copy to clipboard">
                    <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                        <path d="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z"/>
                    </svg>
                    <span class="copy-btn-text">@(_isCopied ? "Copied!" : "Copy")</span>
                </button>
            </div>
        </div>
        <div class="editor-container" id="csharp-editor"></div>
    </section>

    <button class="mobile-generate-btn" @onclick='() => _mobileTab = "csharp"' title="C#-Ausgabe anzeigen">
        <span>Generate</span>
        <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path d="M8.59 16.59L13.17 12 8.59 7.41 10 6l6 6-6 6z" />
        </svg>
    </button>
</div>

@code {
    private string JsonInput { get; set; } = @"{
  ""user_id"": 123,
  ""full_name"": ""Anna Müller"",
  ""is_active"": true,
  ""roles"": [""admin"", ""editor""],
  ""profile"": {
    ""email"": ""anna@example.com"",
    ""created_at"": ""2026-04-19T10:15:30Z"",
    ""settings"": {
      ""newsletter_opt_in"": false,
      ""theme"": ""dark""
    }
  }
}";

    private string DeclarationType { get; set; } = "class";
    private string AttributeMode { get; set; } = "system";
    private bool UseNullableReferences { get; set; } = true;
    private bool UseList { get; set; } = true;
    private string Namespace { get; set; } = string.Empty;
    private string RootClassName { get; set; } = "Root";
    private string PropertyStyle { get; set; } = "get; set;";
    private string ClassSuffix { get; set; } = string.Empty;
    private bool SmartMode { get; set; } = true;
    private string GeneratedCode { get; set; } = string.Empty;
    private string? ErrorMessage { get; set; }
    private string StatusMessage { get; set; } = "Ready.";
    private bool SettingsCollapsed { get; set; } = true;
    private string? InitializationError { get; set; }
    private string? _fullscreenPanel;
    private string _mobileTab = "json";
    private string MobileTabClass => $"tab-{_mobileTab}";

    // Material-Icons: fullscreen / fullscreen_exit
    private const string ExpandIcon = "M7 14H5v5h5v-2H7v-3zm-2-4h2V7h3V5H5v5zm12 7h-3v2h5v-5h-2v3zM14 5v2h3v3h2V5h-5z";
    private const string CollapseIcon = "M5 16h3v3h2v-5H5v2zm3-8H5v2h5V5H8v3zm6 11h2v-3h3v-2h-5v5zm2-11V5h-2v5h5V8h-3z";

    private System.Timers.Timer? _debounceTimer;
    private IJSObjectReference? _jsonEditor;
    private IJSObjectReference? _csharpEditor;
    private DotNetObjectReference<Index>? _dotNetRef;
    private bool _isCopied = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var cookieValue = await JS.InvokeAsync<string>("getCookie", "json2cs_settings");
                if (!string.IsNullOrEmpty(cookieValue))
                {
                    var settings = JsonSerializer.Deserialize<JsonElement>(cookieValue);

                    if (settings.TryGetProperty("declarationType", out var declarationType))
                    {
                        DeclarationType = declarationType.GetString() ?? DeclarationType;
                    }

                    if (settings.TryGetProperty("attributeMode", out var attributeMode))
                    {
                        AttributeMode = attributeMode.GetString() ?? AttributeMode;
                    }

                    if (settings.TryGetProperty("useNullable", out var useNullable))
                    {
                        UseNullableReferences = useNullable.GetBoolean();
                    }

                    if (settings.TryGetProperty("useList", out var useList))
                    {
                        UseList = useList.GetBoolean();
                    }

                    if (settings.TryGetProperty("namespace", out var namespaceValue))
                    {
                        Namespace = namespaceValue.GetString() ?? Namespace;
                    }

                    if (settings.TryGetProperty("rootClassName", out var rootClassName))
                    {
                        RootClassName = string.IsNullOrWhiteSpace(rootClassName.GetString()) ? "Root" : rootClassName.GetString()!;
                    }

                    if (settings.TryGetProperty("propertyStyle", out var propertyStyle))
                    {
                        PropertyStyle = propertyStyle.GetString() ?? PropertyStyle;
                    }

                    if (settings.TryGetProperty("classSuffix", out var classSuffix))
                    {
                        ClassSuffix = classSuffix.GetString() ?? ClassSuffix;
                    }

                    if (settings.TryGetProperty("smartMode", out var smartMode))
                    {
                        SmartMode = smartMode.GetBoolean();
                    }
                }
            }
            catch
            {
                // ignore invalid cookie content
            }

            await InitializeMonacoEditors();
            Generate();
            StateHasChanged();
            await JS.InvokeVoidAsync("updateStatusDisplay", StatusMessage);
        }
    }

    private GeneratorOptions BuildOptions() => new()
    {
        DeclarationType = DeclarationType,
        AttributeMode = AttributeMode,
        UseNullableReferences = UseNullableReferences,
        UseList = UseList,
        Namespace = Namespace,
        RootClassName = RootClassName,
        PropertyStyle = PropertyStyle,
        ClassSuffix = ClassSuffix,
        SmartMode = SmartMode
    };

    private async Task InitializeMonacoEditors()
    {
        try
        {
            // Load Monaco Editor
            await JS.InvokeVoidAsync("eval", @"
                if (!window.require) {
                    var script = document.createElement('script');
                    script.src = 'https://cdn.jsdelivr.net/npm/monaco-editor/min/vs/loader.js';
                    script.onload = function() {
                        require.config({ paths: { vs: 'https://cdn.jsdelivr.net/npm/monaco-editor/min/vs' } });
                        require(['vs/editor/editor.main'], function() {
                            window.monacoLoaded = true;
                        });
                    };
                    document.head.appendChild(script);
                }
            ");

            // Wait for Monaco to load
            await Task.Delay(1000);

            // Create DotNet reference for Monaco callbacks
            _dotNetRef ??= DotNetObjectReference.Create(this);

            // Initialize JSON editor
            _jsonEditor = await JS.InvokeAsync<IJSObjectReference>("initializeMonacoEditor", "json-editor", JsonInput, "json", true, _dotNetRef);

            // Initialize C# editor (read-only)
            _csharpEditor = await JS.InvokeAsync<IJSObjectReference>("initializeMonacoEditor", "csharp-editor",
                string.IsNullOrWhiteSpace(GeneratedCode) ? "// please enter a valid json. C# classes appear here automatically..." : GeneratedCode, "csharp", false);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Failed to initialize Monaco editors: {ex.Message}");
            InitializationError = "The editor could not be initialised. Please reload the page.";
            StateHasChanged();
        }
    }

    [JSInvokable]
    public Task OnJsonChanged(string value)
    {
        OnJsonInputChangedInternal(value);
        return Task.CompletedTask;
    }

    private void OnJsonInputChangedInternal(string value)
    {
        JsonInput = value;

        // Debounce the generation
        _debounceTimer?.Stop();
        _debounceTimer?.Dispose();

        _debounceTimer = new System.Timers.Timer(300);
        _debounceTimer.Elapsed += (sender, e) => {
            InvokeAsync(() => {
                Generate();
                StateHasChanged();
            });
        };
        _debounceTimer.AutoReset = false;
        _debounceTimer.Start();
    }

    private async Task CopyCode()
    {
        if (string.IsNullOrWhiteSpace(GeneratedCode))
        {
            return;
        }

        await JS.InvokeVoidAsync("copyToClipboard", GeneratedCode);
        _isCopied = true;
        StateHasChanged();

        // Reset after 2 seconds
        await Task.Delay(2000);
        _isCopied = false;
        StateHasChanged();
    }

    private async Task SaveSettingsToCookie()
    {
        var settings = new
        {
            declarationType = DeclarationType,
            attributeMode = AttributeMode,
            useNullable = UseNullableReferences,
            useList = UseList,
            @namespace = Namespace,
            rootClassName = RootClassName,
            propertyStyle = PropertyStyle,
            classSuffix = ClassSuffix,
            smartMode = SmartMode
        };

        var json = JsonSerializer.Serialize(settings);
        await JS.InvokeVoidAsync("setCookie", "json2cs_settings", json, 365);
    }

    private void Generate()
    {
        if (string.IsNullOrWhiteSpace(JsonInput))
        {
            ErrorMessage = string.Empty;
            GeneratedCode = string.Empty;

            if (_csharpEditor != null)
            {
                JS.InvokeVoidAsync("updateMonacoEditor", _csharpEditor, "// please enter a valid json.C# classes appear here automatically...");
            }

            return;
        }

        try
        {
            ErrorMessage = string.Empty;
            var result = Generator.Generate(JsonInput, BuildOptions());
            GeneratedCode = result.Code;
            StatusMessage = $"{result.ClassCount} Classes • {result.PropertyCount} Properties • {result.LineCount} Lines";
            JS.InvokeVoidAsync("updateStatusDisplay", StatusMessage);

            if (_csharpEditor != null)
            {
                JS.InvokeVoidAsync("updateMonacoEditor", _csharpEditor, GeneratedCode);
            }
        }
        catch (Exception ex)
        {
            GeneratedCode = string.Empty;
            ErrorMessage = ex.Message;
            StatusMessage = string.Empty;
            JS.InvokeVoidAsync("updateStatusDisplay", "Ready.");

            if (_csharpEditor != null)
            {
                JS.InvokeVoidAsync("updateMonacoEditor", _csharpEditor, "// please enter a valid json. C# classes appear here automatically...");
            }
        }
    }

    private void ToggleSettings()
    {
        SettingsCollapsed = !SettingsCollapsed;
        StateHasChanged();
    }

    private void ToggleFullscreen(string panel)
    {
        _fullscreenPanel = _fullscreenPanel == panel ? null : panel;
        StateHasChanged();
    }

    public void Dispose()
    {
        _debounceTimer?.Dispose();
        _dotNetRef?.Dispose();
    }
}
